# SQL Server
MSSQL_SA_PASSWORD=YourStrong!Password123

# Redis
REDIS_PASSWORD=YourStrong!Password123

# JWT
JWT_KEY=SuperSecretJwtSigningKeyWithAtLeast32Chars!
JWT_ISSUER=sims-auth
JWT_AUDIENCE=sims-api
JWT_EXPIRES_MINUTES=15

# Admin-Konto beim ersten Start
ADMIN_EMAIL=admin@sims.local
ADMIN_PASSWORD=YourStrong!Password123

# Dienste
CORS_ALLOWED_ORIGINS_0=http://localhost:8080
MIGRATIONS_RUN=true
WORKER_POLL_INTERVAL_SECONDS=30
VERDICT_EPSS_NOGO_THRESHOLD=0.5
ESCALATION_CRITICAL_HOURS=4
ESCALATION_HIGH_HOURS=24
ESCALATION_MEDIUM_HOURS=72

# News-API
FEED_URL_1=https://www.cert.at/cert-at.de.warnings.rss_2.0.xml
FEED_URL_2=https://github.blog/feed/
NEWS_REFRESH_MINUTES=30
