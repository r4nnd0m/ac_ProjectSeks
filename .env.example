# PostgreSQL Configuration (wird von postgres:latest genutzt)
POSTGRES_DB=sims
POSTGRES_USER=sims_admin
POSTGRES_PASSWORD=Test123!

# Connection Strings für die .NET Microservices (Npgsql-Format)
CONNECTION_STRINGS_AUTH=Host=sql;Port=5432;Database=sims;Username=sims_admin;Password=Test123!
CONNECTION_STRINGS_SIMS=Host=sql;Port=5432;Database=sims;Username=sims_admin;Password=Test123!

# Redis Configuration
REDIS_PASSWORD=Test123!
CONNECTION_STRINGS_REDIS=redis:6379,password=Test123!

# JWT & App Settings (für spätere API-Services)
JWT_KEY=SuperSecretJwtSigningKeyWithAtLeast32Chars!
JWT_ISSUER=sims-auth
JWT_AUDIENCE=sims-api
JWT_EXPIRES_MINUTES=15
ADMIN_EMAIL=admin@sims.local
ADMIN_PASSWORD=Test123!
CORS_ALLOWED_ORIGINS_0=http://localhost:8080
MIGRATIONS_RUN=true
WORKER_POLL_INTERVAL_SECONDS=30
VERDICT_EPSS_NOGO_THRESHOLD=0.5
ESCALATION_CRITICAL_HOURS=4
ESCALATION_HIGH_HOURS=24
ESCALATION_MEDIUM_HOURS=72
FEEDS_URLS_0=https://example.com/rss
NEWS_REFRESH_MINUTES=30
